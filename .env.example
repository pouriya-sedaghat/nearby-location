# Single configuration template for Docker Compose on the VM.
# Run ./scripts/init-env.sh to create .env with private, random credentials.
# Empty passwords intentionally prevent startup of an uninitialized template.
# Compose fixes NODE_ENV=production, TZ=UTC and the internal database address.
PORT=8080
BASE_URL=/
# Generated as hexadecimal for safe DATABASE_URL interpolation.
POSTGRES_PASSWORD=
SWAGGER_ENABLED=true
SWAGGER_TRY_IT_OUT_ENABLED=true
SWAGGER_AUTH_USERNAME=docs_operator
SWAGGER_AUTH_PASSWORD=
LOCATION_TTL_DAYS=7
CLEANUP_CRON_SCHEDULE='0 3 * * *'
CLEANUP_BATCH_SIZE=5000
DEFAULT_MAX_DISTANCE_METERS=10000
MAX_MAX_DISTANCE_METERS=100000
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=2000
PG_CONNECT_RETRIES=10
PG_CONNECT_BASE_DELAY_MS=1000
