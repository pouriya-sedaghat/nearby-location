{
  "name": "nearby-location",
  "version": "1.0.0",
  "description": "Microservice for storing user location and finding nearby users (PostgreSQL + PostGIS).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:up": "node scripts/run-migration.js up",
    "migrate:down": "node scripts/run-migration.js down",
    "migrate:create": "node scripts/run-migration.js create",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && node --test tests/location.integration.test.js",
    "test": "npm run build && node --test tests/*.test.js",
    "openapi:export": "npm run build && node scripts/export-openapi.js",
    "openapi:check": "npm run build && node scripts/export-openapi.js --check",
    "benchmark:nearby": "npm run build && node scripts/benchmark-nearby.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "node-pg-migrate": "^7.9.1"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "11.1.0"
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "@apidevtools/swagger-parser": "^12.1.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
