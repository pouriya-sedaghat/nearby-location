                      "lat": 35.6892,
                      "lng": 51.389
                    }
                  }
                },
                "cursorFirst": {
                  "summary": "First cursor page",
                  "value": {
                    "coordinate": {
                      "lat": 35.6892,
                      "lng": 51.389
                    },
                    "pagination": "cursor",
                    "pageSize": 10
                  }
                },
                "excludeRequester": {
                  "summary": "Exclude the test user",
