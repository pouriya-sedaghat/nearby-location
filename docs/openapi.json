{
  "openapi": "3.0.0",
  "info": {
    "title": "Nearby Location API",
    "version": "2.14.0",
    "description": "Microservice to store user location and find nearby users with PostgreSQL + PostGIS Human-readable API messages and display ages support English (default) and Persian through Accept-Language. Keys, identifiers, numbers, status codes and ISO timestamps remain unchanged. Documentation and Prometheus exposition remain English."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API origin or configured base URL"
    }
  ],
  "components": {
    "schemas": {
      "Coordinate": {
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": 35.6892
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": 51.389
          }
        },
        "description": "WGS84 decimal degrees. lat is latitude (Y); lng is longitude (X)."
      },
      "NearbyUser": {
        "type": "object",
        "required": [
          "userId",
          "coordinate",
          "distance",
          "updatedAt",
          "updateStatus"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "distance": {
            "type": "number",
            "minimum": 0,
            "description": "Distance from the request coordinate in meters."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updateStatus": {
            "type": "string",
            "example": "5 minutes ago",
            "description": "English or Persian display age recalculated from updatedAt using one server instant captured at request start. Short units are elapsed units; months/years use completed UTC Gregorian calendar anniversaries with month-end clamping in both languages. Future timestamps show zero age. Age is not stored; updatedAt remains exact."
          }
        },
        "description": "The coordinate belongs to the result user and is read from their stored current location. Internal ranking scores are omitted."
      },
      "UpsertRequest": {
        "type": "object",
        "required": [
          "userId",
          "coordinate"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "example": "user_123",
            "description": "Trimmed, well-formed Unicode identifier (no lone UTF-16 surrogates). Control characters are rejected. Runtime length is 1-255 UTF-16 code units after trimming; astral characters use two units."
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          }
        }
      },
      "NearbyRequest": {
        "type": "object",
        "required": [
          "coordinate"
        ],
        "properties": {
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "maxDistance": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 100000,
            "default": 10000
          },
          "excludeUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "description": "Trimmed, well-formed Unicode identifier (no lone UTF-16 surrogates). Control characters are rejected. Runtime length is 1-255 UTF-16 code units after trimming; astral characters use two units."
          },
          "pagination": {
            "type": "string",
            "enum": [
              "offset",
              "cursor"
            ],
            "default": "offset"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 1,
            "description": "Offset mode only. (page - 1) * pageSize must be a safe integer."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400,
            "description": "Opaque nextCursor from a previous response; cannot be combined with page or pagination=offset."
          }
        },
        "description": "Body fields override query fields with the same name. Keep coordinate, maxDistance and excludeUserId identical across cursor pages."
      },
      "NearbyOffsetResponse": {
        "type": "object",
        "required": [
          "success",
          "paginationMode",
          "rankingMode",
          "page",
          "pageSize",
          "totalCount",
          "totalPages",
          "hasMore",
          "nextCursor",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "paginationMode": {
            "type": "string",
            "enum": [
              "offset"
            ]
          },
          "rankingMode": {
            "type": "string",
            "enum": [
              "legacy",
              "decay"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NearbyUser"
            }
          }
        }
      },
      "NearbyCursorResponse": {
        "type": "object",
        "required": [
          "success",
          "paginationMode",
          "rankingMode",
          "pageSize",
          "totalCount",
          "hasMore",
          "nextCursor",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "paginationMode": {
            "type": "string",
            "enum": [
              "cursor"
            ]
          },
          "rankingMode": {
            "type": "string",
            "enum": [
              "legacy",
              "decay"
            ]
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NearbyUser"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true,
            "description": "Zod formatted field errors, present for request validation failures."
          }
        }
      }
    },
    "securitySchemes": {
      "locationBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque service token",
        "description": "LOCATION_AUTH_TOKEN for /location only. Enter the token without the Bearer prefix."
      },
      "metricsBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque service token",
        "description": "METRICS_AUTH_TOKEN for /metrics only. Enter the token without the Bearer prefix."
      },
      "privacyBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque service token",
        "description": "PRIVACY_AUTH_TOKEN for privacy erasure only. Enter the token without the Bearer prefix."
      }
    },
    "parameters": {
      "ResponseLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "description": "en (default) or fa. Regional tags and quality weights are supported; unsupported preferences fall back to English. Machine fields are unchanged.",
        "schema": {
          "type": "string",
          "default": "en"
        },
        "example": "fa"
      }
    }
  },
  "paths": {
    "/privacy/location/delete": {
      "post": {
        "tags": [
          "Privacy"
        ],
        "summary": "Permanently delete a user's current live location",
        "description": "Idempotent privacy erasure command with normalized upsert identifier rules. The privacy API is disabled by default and, when enabled, requires its own bearer token. To delete a stored identifier byte-for-byte, use /privacy/location/delete-exact instead; this route rejects a match field because the pre-fix 2.13.5 build at 014d80e silently ignores it. Other unknown fields are stripped. Ill-formed Unicode is rejected. Stop upstream publishing before invoking this command; a later upsert can create a new live location again.",
        "security": [
          {
            "privacyBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId"
                ],
                "properties": {
                  "userId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                    "description": "Same rules as upsert: trimmed, well-formed Unicode, control characters rejected (never trimmed away). Length is 1-255 UTF-16 code units after trimming. Deletes the identity an upsert of the same input writes.",
                    "example": "user_123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Erasure command completed. The response does not reveal whether a row existed.",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "400": {
            "description": "Invalid request body, including any match field",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "401": {
            "description": "Missing or invalid privacy bearer token",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "413": {
            "description": "JSON request body exceeds 32 KB",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "415": {
            "description": "Unsupported request encoding or charset",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          }
        },
        "operationId": "deleteUserLocation",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          }
        ]
      }
    },
    "/privacy/location/delete-exact": {
      "post": {
        "tags": [
          "Privacy"
        ],
        "summary": "Permanently delete the live location of an exact stored identifier",
        "description": "Idempotent privacy erasure of the stored identifier byte-for-byte, with no trimming or other normalization: use it for a userId returned by a nearby response or stored under older rules (for example control characters before 2.13.1). Deletes at most one row and never falls back to the normalized route. Builds without this route, including the pre-fix 2.13.5 build at 014d80e, answer 404 without deleting anything; treat 404 as \"not performed\" and retry, never as success. Version 2.14.0 includes this route; identify deployed binaries by version and commit/image digest. Requires the privacy bearer token.",
        "security": [
          {
            "privacyBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId"
                ],
                "additionalProperties": false,
                "properties": {
                  "userId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[^\\u0000]*$",
                    "description": "Stored identifier byte-for-byte. Must be nonblank, well-formed Unicode and free of NUL; other control characters and surrounding whitespace are kept. Length is 1-255 UTF-16 code units without trimming.",
                    "example": " legacy_user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Erasure command completed. The response does not reveal whether a row existed.",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "400": {
            "description": "Invalid request body, including unknown fields",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "401": {
            "description": "Missing or invalid privacy bearer token",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "404": {
            "description": "Route not available (privacy API disabled, or a release without exact erasure). Nothing was deleted.",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "413": {
            "description": "JSON request body exceeds 32 KB",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "415": {
            "description": "Unsupported request encoding or charset",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          }
        },
        "operationId": "deleteExactUserLocation",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          }
        ]
      }
    },
