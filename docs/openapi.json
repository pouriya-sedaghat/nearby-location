    "/location/upsert": {
      "post": {
        "tags": [
          "Location"
        ],
        "summary": "Upsert user location",
        "description": "Create or update the latest location for a user. When LOCATION_AUTH_MODE=bearer, send Authorization: Bearer <token>.",
        "security": [
          {
            "locationBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRequest"
              },
              "examples": {
                "create": {
                  "summary": "Create a test location",
                  "value": {
                    "userId": "demo-user",
                    "coordinate": {
                      "lat": 35.6892,
                      "lng": 51.389
                    }
                  }
                },
                "update": {
                  "summary": "Update the test user",
                  "value": {
                    "userId": "demo-user",
                    "coordinate": {
                      "lat": 35.7,
                      "lng": 51.4
                    }
                  }
                },
                "zeroCoordinates": {
                  "summary": "Valid zero coordinates",
                  "value": {
                    "userId": "origin-user",
                    "coordinate": {
                      "lat": 0,
                      "lng": 0
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location upserted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string",
                      "example": "Location upserted successfully"
                    }
                  }
                }
              }
            },
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "401": {
            "description": "Missing or invalid service bearer token when location authentication is enabled",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "413": {
            "description": "JSON request body exceeds 32 KB",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "415": {
            "description": "Unsupported request encoding or charset",
            "headers": {
              "Content-Language": {
                "description": "Language used for human-readable response text.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fa"
                  ]
                }
              },
              "Vary": {
                "description": "Includes Accept-Language.",
                "schema": {
                  "type": "string"
                },
                "example": "Accept-Language"
              }
            }
          },
          "429": {
            "description": "Too many requests (when the optional per-replica limiter is enabled)",
            "headers": {
              "X-Nearby-Rejection-Reason": {
                "schema": {
                  "type": "string"
                },
                "description": "Machine-readable controlled rejection reason (rate_limit)"
              },
              "Content-Language": {
