  "paths": {
    "/location/upsert": {
      "post": {
        "tags": [
          "Location"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          }
        ],
        "operationId": "upsertLocation",
        "summary": "Create or update a user's location",
        "description": "Stores one current location per userId. Reusing an identifier updates coordinate and updatedAt, preserving createdAt. Identifiers are trimmed and must contain well-formed Unicode without NUL. Coordinate values must be JSON numbers. Execute performs a real write.",
        "requestBody": {
          "$ref": "#/components/requestBodies/UpsertLocation"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LocationUpserted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidUpsert"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedEncoding"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/location/nearby": {
      "post": {
        "tags": [
          "Location"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          },
          {
            "in": "query",
            "name": "page",
            "description": "One-based page. Both page and (page - 1) * pageSize must be safe integers. Separate pages do not share a database snapshot.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1,
              "example": 1,
              "description": "One-based page. Both page and (page - 1) * pageSize must be safe integers. Separate pages do not share a database snapshot."
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "description": "Number of results per page, from 1 through 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10,
              "description": "Number of results per page, from 1 through 100."
            }
          },
          {
            "in": "query",
            "name": "maxDistance",
            "description": "Inclusive search radius in meters. Positive numeric strings are also accepted at runtime. Defaults and limits reflect this process configuration.",
            "schema": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 100000,
              "default": 10000,
              "example": 10000,
              "description": "Inclusive search radius in meters. Positive numeric strings are also accepted at runtime. Defaults and limits reflect this process configuration."
            }
          },
          {
            "in": "query",
            "name": "excludeUserId",
            "description": "Optional identifier to omit. The requester is not excluded automatically. Trimmed identifier containing well-formed Unicode and no NUL. Length is measured after trimming, in UTF-16 code units. Identifier ownership is enforced by the deployment, not this service.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\u0000]*$",
              "description": "Optional identifier to omit. The requester is not excluded automatically. Trimmed identifier containing well-formed Unicode and no NUL. Length is measured after trimming, in UTF-16 code units. Identifier ownership is enforced by the deployment, not this service."
            }
          }
        ],
        "operationId": "findNearbyUsers",
        "summary": "Search fresh nearby locations",
        "description": "Start with Search center only to use query inputs. Body fields override matching query fields. Radius is inclusive and measured in meters; stale rows are excluded before ranking. Results use the existing distance/recency score, then userId, and include each matched user's stored coordinates. The requester is excluded only when excludeUserId is supplied.",
        "requestBody": {
          "$ref": "#/components/requestBodies/NearbySearch"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/NearbyResults"
          },
          "400": {
            "$ref": "#/components/responses/InvalidNearby"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedEncoding"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          }
        ],
        "operationId": "getLiveness",
        "summary": "Check process liveness",
        "description": "Returns immediately without using PostgreSQL. A successful response proves only that the HTTP process can answer.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Live"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          }
        ],
        "operationId": "getReadiness",
        "summary": "Check database connectivity",
        "description": "Runs SELECT 1 through the pool. It does not verify migrations, the locations table, or spatial queries. After deployment, also test upsert and nearby operations.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ready"
