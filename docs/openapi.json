    "/location/nearby": {
      "post": {
        "tags": [
          "Location"
        ],
        "summary": "Find nearby users",
        "description": "Find fresh nearby user locations within a bounded radius. Each data item includes the stored coordinate of that result user. Supports offset and cursor pagination. When LOCATION_AUTH_MODE=bearer, send Authorization: Bearer <token>.",
        "security": [
          {
            "locationBearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "pagination",
            "schema": {
              "type": "string",
              "enum": [
                "offset",
                "cursor"
              ],
              "default": "offset"
            },
            "required": false,
            "description": "Use cursor for deep/streaming pagination. Supplying cursor also selects cursor mode."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "required": false,
            "description": "Offset page number. Cannot be combined with cursor mode."
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "description": "Number of items per page"
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2400
            },
            "required": false,
            "description": "Opaque nextCursor returned by a previous response"
          },
          {
            "in": "query",
            "name": "maxDistance",
            "schema": {
              "type": "number",
              "default": 10000,
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 100000
            },
            "required": false,
            "description": "Maximum distance in meters"
          },
          {
            "in": "query",
            "name": "excludeUserId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "required": false,
            "description": "User id to exclude from the result set (typically the requester)"
          },
          {
            "$ref": "#/components/parameters/ResponseLanguage"
          }
        ],
        "requestBody": {
